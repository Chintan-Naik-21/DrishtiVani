# ==============================================================================
# Accessible Engineering Notes - Ingestion Service Configuration
# ==============================================================================

# Supabase API Credentials
# Found in: Supabase Dashboard -> Project Settings -> API
# Use the Project URL and the service_role secret key (NOT the anon key).
# The service-role key is kept strictly server-side and never exposed to clients.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-key

# Supabase Postgres Connection String
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# IMPORTANT: Use the Connection Pooler URI (Transaction mode, port 6543), NOT the Direct connection (port 5432).
# Example: postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Storage Buckets (will be automatically created as PRIVATE buckets on startup if missing)
SUPABASE_BUCKET_HANDOUTS=handouts
SUPABASE_BUCKET_PAGES=pages
SUPABASE_BUCKET_CROPS=crops

# PDF Ingestion & Rendering
# Free-tier storage is limited (~1 GB), 150 DPI provides optimal OCR quality with minimal storage footprint.
RENDER_DPI=150
# Supported formats: PNG (optimized lossless) or JPEG (high-quality lossy)
PAGE_IMAGE_FORMAT=PNG

# Signed URL Expiration (in seconds)
# Default: 3600 (1 hour). Stored paths in DB are static, signed URLs are generated on-the-fly for API responses.
SIGNED_URL_EXPIRATION_SECONDS=3600

# Block Confidence Threshold
# Blocks with layout or OCR confidence lower than this threshold will have needs_review = True.
CONFIDENCE_THRESHOLD=0.80

# Optional LayoutLMv3 Fallback Classifier (default: false, uses Surya by default)
USE_LAYOUTLMV3_FALLBACK=false

# Database Connection Pooling (tuned for Supabase connection pooler / PgBouncer)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=300

# Application Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO

# Test/CI flag: set to true to bypass strict live Supabase DB & Storage checks on startup
SKIP_STARTUP_CHECKS=false
